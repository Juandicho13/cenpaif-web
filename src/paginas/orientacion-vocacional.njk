---
{
    "titulo": "Orientación Vocacional - CENPAIF",
    "descripcion": "CENPAIF, centro de psicólogos en Chía. Servicios de psicología individual, familiar, de pareja, infantil y juvenil, con enfoque en inteligencia emocional."
}
---
{% extends "base.njk" %}
{% import "macros.njk" as m %}

{% block contenido %}

{# ---------- Portada ---------- #}
<section class="e-seccion">
    <div class="e-contenedor">
        <div class="e-columna">
            <div class="e-envoltura">
                <div class="ancla"></div>
                <section class="e-seccion caja-servicio caja-servicio--contener">
                    <div class="caja-servicio__fondo">{{ foto('servicio-vocacional', '', { tamanos: '(max-width: 767px) 92vw, 1120px', prioridad: true }) }}</div>
                    <div class="ola ola--abajo">{{ forma('olas') }}</div>
                    <div class="e-contenedor">
                        <div class="e-columna">
                            <div class="e-envoltura">
                                <div class="espacio-portada espacio-portada--cero-movil"></div>
                            </div>
                        </div>
                        <div class="e-columna e-centrar">
                            <div class="e-envoltura vidrio">
                                {{ m.titulo('Orientación Vocacional', 'h3', 'titulo-script') }}
                                <div class="texto-gilroy texto-gilroy--normal texto-gilroy--25">
                                    <p>Descubre tu Futuro Ideal reconociendo tus talentos.</p>
                                </div>
                                {{ m.boton('Orientación Vocacional Presencial y Virtual', whatsapp('Hola, quiero información sobre la orientación vocacional.')) }}
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

{# ---------- Contenido ---------- #}
<section class="e-seccion bloque-gris">
    <div class="e-contenedor e-contenedor--ancho">
        <div class="e-columna">
            <div class="e-envoltura">
                <div class="espacio"></div>
                <div class="fila-vacia ancla"></div>
                <section class="e-seccion">
                    <div class="e-contenedor">
                        <div class="e-columna e-centrar">
                            <div class="e-envoltura">
                                <h2 class="titulo-e titulo-e--manrope">Orientación Vocacional</h2>
                                <div class="cita">
                                    <p>Acompañamiento profesional para reconocerse a si mismo tomando decisiones certeras.</p>
                                </div>
                                {{ m.boton('Orientación Vocacional Presencial y Virtual', whatsapp('Hola, quiero información sobre la orientación vocacional.')) }}
                                <h2 class="titulo-e titulo-e--manrope">¿Porqué es importante?</h2>
                                <div class="cita">
                                    <p><strong>Beneficios:</strong></p>
                                    <ul>
                                        <li><strong>Autoconocimiento:</strong> Descubre tus talentos, intereses y valores.</li>
                                        <li><strong>Toma de decisiones informadas:</strong> Elige una carrera que te apasione y te permita alcanzar tus metas.</li>
                                        <li><strong>Prevención del fracaso académico:</strong> Evita cambiar de carrera o abandonar tus estudios.</li>
                                        <li><strong>Mayor satisfacción laboral:</strong> Encuentra un trabajo que se adapte a tu perfil y te haga feliz.</li>
                                    </ul>
                                </div>
                                <h2 class="titulo-e titulo-e--manrope">¿Cómo lo hacemos?</h2>
                                <div class="cita">
                                    <ul>
                                        <li><strong>Pruebas personalizadas:</strong> Identificamos tus habilidades y preferencias.</li>
                                        <li>Cartilla material de trabajo.</li>
                                        <li><strong>Plan de acción claro:</strong>&nbsp;Orientación a padres si lo requieren.</li>
                                        <li>Identificación de habilidades personales, gustos y preferencias.</li>
                                        <li>Reconocimiento del perfil profesional y campo laboral.</li>
                                    </ul>
                                    <p><a href="{{ whatsapp('Hola, quiero información sobre la orientación vocacional.') }}" target="_blank" rel="noopener"><br>Más Información</a></p>
                                </div>
                                <h2 class="titulo-e titulo-e--manrope">Prepraración para el ingreso a la universidad y a la vida en el exterior.</h2>
                                <div class="cita">
                                    <ul>
                                        <li>Asesorías para presentar pruebas de estado</li>
                                        <li>Preparación para el ingreso a la universidad</li>
                                        <li>Capacitación en habilidades para la vida en el exterior.</li>
                                    </ul>
                                </div>
                                <div class="cita">
                                    <ul>
                                        <li class="sin-vineta">¡¡Decídete y escribemos para iniciar!!.&nbsp;<ul>&nbsp;</ul></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

{% endblock %}