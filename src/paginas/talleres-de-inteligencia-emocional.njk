---
{
    "titulo": "Talleres de Inteligencia Emocional - CENPAIF",
    "descripcion": "CENPAIF, centro de psicólogos en Chía. Servicios de psicología individual, familiar, de pareja, infantil y juvenil, con enfoque en inteligencia emocional.",
    "imagen": "taller-emocional-1"
}
---
{% extends "base.njk" %}
{% import "macros.njk" as m %}

{% set formulario = 'https://docs.google.com/forms/d/e/1FAIpQLSeHJF2BrzNql-gVpNsFs0UqZ0nPH1FnCEQUpyOtw0Xy8kVWWw/viewform?usp=header' %}

{% block contenido %}

{# ---------- Portada ---------- #}
<section class="e-seccion">
    <div class="e-contenedor">
        <div class="e-columna">
            <div class="e-envoltura">
                <div class="ancla"></div>
                <section class="e-seccion caja-servicio caja-servicio--contener">
                    <div class="caja-servicio__fondo">{{ foto('servicio-talleres-emocionales', '', { tamanos: '(max-width: 767px) 92vw, 1120px', prioridad: true }) }}</div>
                    <div class="ola ola--abajo">{{ forma('olas') }}</div>
                    <div class="e-contenedor">
                        <div class="e-columna e-centrar">
                            <div class="e-envoltura vidrio">
                                {{ m.titulo('Talleres de inteligencia emocional', 'h3', 'titulo-script') }}
                                <div class="texto-gilroy texto-gilroy--normal texto-gilroy--24">¡Domina tus emociones!</div>
                                {{ m.boton('Formulario de Inscripción', formulario) }}
                            </div>
                        </div>
                        <div class="e-columna">
                            <div class="e-envoltura">
                                <div class="espacio-portada espacio-portada--79"></div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

{# ---------- Contenido ---------- #}
<section class="e-seccion bloque-gris">
    <div class="e-contenedor e-contenedor--ancho">
        <div class="e-columna">
            <div class="e-envoltura">
                <div class="fila-vacia ancla"></div>
                <section class="e-seccion">
                    <div class="e-contenedor">
                        <div class="e-columna e-centrar">
                            <div class="e-envoltura">
                                <h2 class="titulo-e titulo-e--manrope titulo-e--negro titulo-e--centro">¿Quieres sentirte más feliz y en control de tu vida?</h2>
                                <h2 class="titulo-e titulo-e--manrope titulo-e--negro">Nuestros talleres te enseñarán a:</h2>
                                <div class="cita">
                                    <ul>
                                        <li>Conocer tus emociones: Identifica y comprende tus sentimientos.</li>
                                        <li>Gestionar el estrés: Reduce la ansiedad y mejora tu bienestar.</li>
                                        <li>Mejorar tus relaciones: Fortalece tus vínculos con los demás.</li>
                                        <li>Aumentar tu autoestima: Confía en ti mismo y alcanza tus metas.</li>
                                    </ul>
                                </div>
                                <h2 class="titulo-e titulo-e--manrope titulo-e--negro">¿Cómo lo hacemos?</h2>
                                <div class="cita">
                                    <ul>
                                        <li>&nbsp;Metodología vivencial y práctica del diario vivir.&nbsp; Test autoaplicables.&nbsp;</li>
                                        <li>Rotativos. Sábamos 8:00 a.m. Duración de 1 hora.&nbsp;</li>
                                        <li>Con encuentros virtuales donde resolverás dudas y desarrollarás habilidades que te brindarán:</li>
                                        <li>Mayor bienestar emocional.</li>
                                        <li>Mejor calidad de vida.</li>
                                        <li>Desarrollo personal.</li>
                                    </ul>
                                </div>
                                <div class="titulo-ekit titulo-ekit--movil-centro titulo-grande--sube"><div class="titulo-ekit__raya"></div></div>
                                {{ m.boton('Inscríbete y nos comunicaremos contigo', formulario) }}
                                <div class="texto-gilroy texto-gilroy--normal texto-gilroy--28">¡Mereces crear la vida que quieres!</div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="espacio-20 ancla"></div>
                <section class="e-seccion fila-talleres">
                    <div class="e-contenedor e-contenedor--ancho">
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-1', 'Re.descubre tu valor', 'Sumérgete en un camino de autoconocimiento y crecimiento personal. Descubre el poder de transformar el amor propio como base de relaciones sanas.') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-2', 'Amando juntos ', 'Fortalece tu relación desde el interior. Desarrolla una base sólida de confianza que permitirá que tu relación se fortalezca. Alcanza un nuevo nivel de autoestima y felicidad junto a tu pareja!.') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-3', 'Creciendo juntos. ', 'Refuerza tu confianza y guía a tus hijos con seguridad. Fortalece la relación a través del apoyo emocional y la comunicación positiva. Educa en autonomía y empoderamiento!.') }}
                        </div></div>
                    </div>
                </section>
                <section class="e-seccion fila-talleres">
                    <div class="e-contenedor e-contenedor--ancho">
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-4', 'Inteligencia emocional en acción', 'Desarrolla tu inteligencia emocional y transforma tu vida. Aprende a gestionar tus emociones, mejorar tus relaciones y alcanzar tu máximo. potencial.') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-5', 'Complicidad emocional', 'Desarrolla una conexión más profunda y fortalecer tu vínculo emocional. Fortalece la capacidad de entender y responder a las emociones de tu pareja.') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-6', 'Liderazgo emocional en la paternidad', 'Ser un padre emocionalmente inteligente es fundamental para educar hijos felices y seguros. Aprende cómo manejar tus emociones y las de tus hijos de manera efectiva.') }}
                        </div></div>
                    </div>
                </section>
                <section class="e-seccion fila-talleres">
                    <div class="e-contenedor e-contenedor--ancho">
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-7', 'Interacciones exitosas ', 'Desarrolla una conexión más profunda y fortalecer tu vínculo emocional. Fortalece la capacidad de entender y responder a las emociones de tu pareja.') }}
                            {{ m.video('taller-auto-estima.mp4', 'solo-celular-taller') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-8', 'Parejas comunicativas', 'Fortalece tu relación con una comunicación afectiva y asertiva. Exprésate claramente y a escucha activamente a tu pareja. Aprende técnicas efectivas para interactuar con confianza, empatía y comprensión. Adquiere habilidades para manejar desacuerdos y conflictos de manera constructiva en pareja.') }}
                            {{ m.video('taller-inteligencia.mp4', 'solo-celular-taller') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.taller('taller-emocional-9', 'Padres conecta.dos', 'Desarrolla habilidades esenciales y fortalecer los vínculos con tus hijos, promoviendo una mejor comunicación y entendimiento. Establece autoridad respetuosa y comprensiva. Establece límites de manera efectiva y consistente.') }}
                        </div></div>
                    </div>
                </section>
                <section class="e-seccion fila-talleres oculto-movil">
                    <div class="e-contenedor e-contenedor--ancho">
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.video('taller-auto-estima.mp4') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura">
                            {{ m.video('taller-inteligencia.mp4') }}
                        </div></div>
                        <div class="e-columna"><div class="e-envoltura"></div></div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>
<div class="espacio-final"></div>

{{ m.ventanaVideo() }}

{% endblock %}