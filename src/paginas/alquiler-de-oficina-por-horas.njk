---
{
    "titulo": "Alquiler de oficina por horas en Chía - CENPAIF",
    "descripcion": "Alquiler de oficina gerencial privada y amoblada en Chía, por horas o por planes mensuales, con internet, recepción, parqueadero y terraza.",
    "imagen": "fachada-edificio"
}
---
{% extends "base.njk" %}
{% import "macros.njk" as m %}

{% set formulario = 'https://docs.google.com/forms/d/e/1FAIpQLSexQWdDP3Yh4ZwiszT7yjvsJppI-YIYPyG5tT1F_bMo632D1w/viewform' %}
{% set mensaje = 'Hola, quiero información sobre el alquiler de la oficina.' %}

{# Fotos del espacio: [foto, descripción] (se abren en el visor) #}
{% set fotos = [
    ['consultorio-vista', 'Oficina gerencial privada'],
    ['consultorio-escritorio', 'Escritorio y zona de atención'],
    ['sala-de-espera', 'Sala de espera'],
    ['recepcion', 'Recepción'],
    ['ingreso-ascensores', 'Ingreso y ascensores'],
    ['parqueadero', 'Parqueadero'],
    ['terraza-montanas', 'Terraza'],
    ['terraza-vista', 'Terraza con vista a Chía'],
    ['fachada-edificio', 'Edificio Offices Center Chía Elite']
] %}

{% block precarga %}
    {{ precargarFoto('consultorio-ventanal', '(max-width: 767px) 92vw, 520px') }}
{% endblock %}

{% block contenido %}

{# ---------- Portada ---------- #}
<section class="pagina-portada">
    <div class="pagina-portada__caja">
        <div class="pagina-portada__texto">
            <h1 class="pagina-portada__titulo">Co-working en Chía</h1>
            <p class="pagina-portada__lema">Oficina gerencial privada, por horas o por planes</p>
            <ul class="chips">
                <li>Alquiler de oficina gerencial privada por jornadas</li>
                <li>Proyecta una imagen de confianza y prestigio</li>
                <li>Oficina gerencial amoblada privada</li>
                <li>Excelente ubicación, sobre la Av. Bolívar</li>
            </ul>
            <div class="pagina-portada__botones">
                {{ m.boton('Solicita la oficina', formulario, 'izquierda') }}
                {{ m.boton('Escríbenos por WhatsApp', whatsapp(mensaje), 'izquierda', 'boton-envoltura--suave') }}
            </div>
        </div>
        <figure class="pagina-portada__foto pagina-portada__foto--redonda">
            {{ foto('consultorio-ventanal', 'Oficina gerencial privada con ventanal a las montañas', { tamanos: '(max-width: 767px) 92vw, 520px', prioridad: true }) }}
        </figure>
    </div>
</section>

{# ---------- Planes y precios ---------- #}
<section class="bloque bloque--blanco">
    <div class="bloque__caja">
        <div class="seccion-cabeza">
            {{ m.titulo('Planes y precios', 'h2', 'titulo-ekit--verde') }}
            <p>Escoge nuestros planes o elige el de tu conveniencia. Horas fijas o seleccionadas, según tu preferencia.</p>
        </div>
        <ul class="planes">
            <li class="plan">
                <h3 class="plan__nombre">Por hora</h3>
                <p class="plan__precio">$48.000 <span>la hora</span></p>
                <p class="plan__nota">Según disponibilidad</p>
                <ul class="plan__lista">
                    <li>Oficina privada amoblada</li>
                    <li>Servicio de internet</li>
                    <li>Recepción y parqueadero</li>
                </ul>
            </li>
            <li class="plan">
                <h3 class="plan__nombre">Plan 8 horas mensuales</h3>
                <p class="plan__precio">$320.000 <span>al mes</span></p>
                <p class="plan__nota">Espacio físico</p>
                <ul class="plan__lista">
                    <li>Incluye todos los servicios</li>
                    <li>Horas fijas o seleccionadas</li>
                    <li>Según preferencia</li>
                </ul>
            </li>
            <li class="plan plan--destacado">
                <h3 class="plan__nombre">Plan 64 horas mensuales</h3>
                <p class="plan__precio">$960.000 <span>al mes</span></p>
                <p class="plan__nota">Espacio físico</p>
                <ul class="plan__lista">
                    <li>Incluye todos los servicios</li>
                    <li>Horas fijas o seleccionadas</li>
                    <li>Según preferencia</li>
                </ul>
            </li>
        </ul>
        <p class="planes__extra">Sala de conferencias y dirección comercial: <strong>$80.000</strong> para planes de 3 meses en adelante.</p>
    </div>
</section>

{# ---------- Qué incluye ---------- #}
<section class="bloque bloque--niebla">
    <div class="bloque__caja">
        {{ m.titulo('Todo lo que incluye', 'h2', 'titulo-ekit--verde') }}
        <ul class="incluye">
            <li><strong>Amoblado</strong><span>Listo para trabajar o atender</span></li>
            <li><strong>Servicio de internet</strong><span>En la oficina</span></li>
            <li><strong>Recepción</strong><span>Para recibir a tus clientes</span></li>
            <li><strong>Parqueadero</strong><span>En el edificio</span></li>
            <li><strong>Sin contrato de arrendamiento</strong><span>Hasta terminar el saldo</span></li>
            <li><strong>De domingo a domingo</strong><span>En cualquier horario requerido</span></li>
            <li><strong>Terraza y gimnasio</strong><span>Zonas comunes del edificio</span></li>
            <li><strong>Zona de eventos</strong><span>Para reuniones y talleres</span></li>
        </ul>
    </div>
</section>

{# ---------- Conoce el espacio (las fotos se abren en grande) ---------- #}
<section class="bloque bloque--blanco">
    <div class="bloque__caja">
        {{ m.titulo('Conoce el espacio', 'h2', 'titulo-ekit--verde') }}
        <ul class="fotos-espacio" data-visor>
            {% for f in fotos %}
            <li>
                <a class="galeria__ampliar fotos-espacio__enlace" href="{{ rutaFoto(f[0], 1600) }}" data-miniatura="{{ rutaFoto(f[0], 400) }}" aria-label="Ver en grande: {{ f[1] }}">
                    {{ foto(f[0], '', { tamanos: '(max-width: 767px) 92vw, 370px' }) }}
                </a>
                <p>{{ f[1] }}</p>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# ---------- Cómo solicitarla ---------- #}
<section class="bloque bloque--niebla">
    <div class="bloque__caja">
        {{ m.titulo('Cómo solicitar la oficina', 'h2', 'titulo-ekit--verde') }}
        <ol class="pasos">
            <li>
                <h3>Diligencia el formulario</h3>
                <p>Y anexa los documentos solicitados: cédula, RUT, cámara de comercio y tarjeta profesional si aplica.</p>
                {{ m.boton('Solicita la oficina', formulario, 'izquierda') }}
            </li>
            <li>
                <h3>Solicita la fecha por WhatsApp</h3>
                <p>Escríbenos al <a href="{{ whatsapp(mensaje) }}" target="_blank" rel="noopener">313 2712530</a> para agendar la fecha según el plan que escogiste.</p>
                {{ m.boton('Escríbenos por WhatsApp', whatsapp(mensaje), 'izquierda') }}
            </li>
        </ol>
    </div>
</section>

{{ m.visorFotos() }}
{% endblock %}
