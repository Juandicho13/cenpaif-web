{# Título de ElementsKit con la raya de puntos.
   clase: titulo-ekit--centro, --movil-centro, --verde, --400, --29, titulo-grande, titulo-grande--sube, titulo-script #}
{% macro titulo(texto, nivel='h3', clase='') %}
<div class="titulo-ekit {{ clase }}">
    <{{ nivel }} class="titulo-ekit__texto">{{ texto | safe }}</{{ nivel }}>
    <div class="titulo-ekit__raya"></div>
</div>
{% endmacro %}

{# Botón lila de Elementor. alinear: centro (por defecto), izquierda #}
{% macro boton(texto, url, alinear='centro', clase='') %}
<div class="boton-envoltura boton-envoltura--{{ alinear }} {{ clase }}">
    <a class="boton" href="{{ url }}"{% if url.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ texto }}</a>
</div>
{% endmacro %}

{# Tarjeta de taller: imagen, título y texto #}
{% macro taller(foto_, titulo, texto, clase='') %}
<div class="taller {{ clase }}">
    <figure class="taller__img">{{ foto(foto_, '', { tamanos: '(max-width: 767px) 70vw, 309px' }) }}</figure>
    <h3>{{ titulo }}</h3>
    <p>{{ texto }}</p>
</div>
{% endmacro %}

{# "Ver Video" con el botón redondo que abre el video #}
{% macro video(archivo, clase='') %}
<h2 class="ver-video {{ clase }}">Ver Video</h2>
<div class="video-boton-caja {{ clase }}">
    <button type="button" class="video-boton" data-video="/videos/{{ archivo }}" aria-label="Ver el video">{{ icono('play') }}</button>
</div>
{% endmacro %}

{# Visor de fotos de las galerías (uno por página; lo maneja sitio.js) #}
{% macro visorFotos() %}
<dialog class="visor" id="visor" aria-label="Foto en grande">
    <div class="visor__caja">
        <div class="visor__foto">
            <img class="visor__img" alt="">
            <button type="button" class="visor__lado visor__lado--prev" data-ir="-1" aria-label="Foto anterior">
                <span class="visor__pastilla">Prev<span class="visor__circulo"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M6.5 1.5 3 5l3.5 3.5" fill="none" stroke="#fff" stroke-width="1.8"/></svg></span></span>
            </button>
            <button type="button" class="visor__lado visor__lado--next" data-ir="1" aria-label="Foto siguiente">
                <span class="visor__pastilla">Next<span class="visor__circulo"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 1.5 7 5 3.5 8.5" fill="none" stroke="#fff" stroke-width="1.8"/></svg></span></span>
            </button>
            <div class="visor__miniaturas"></div>
            <button type="button" class="visor__expandir" aria-label="Ver la foto en su tamaño real">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 6V1h5M10 1h5v5M15 10v5h-5M6 15H1v-5" fill="none" stroke="#fff" stroke-width="1.6"/></svg>
            </button>
        </div>
        <div class="visor__barra">
            <div class="visor__nav">
                <button type="button" class="visor__play" aria-label="Pasar las fotos solas">
                    <svg class="visor__reproducir" viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1l10 6-10 6z" fill="#a8a8a8"/></svg>
                    <svg class="visor__pausa" viewBox="0 0 12 14" aria-hidden="true"><path d="M2 1h3v12H2zM7 1h3v12H7z" fill="#a8a8a8"/></svg>
                </button>
                <button type="button" class="visor__flecha" data-ir="-1" aria-label="Foto anterior">
                    <svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="7" fill="#c9c9c9"/><path d="M7.5 3.8 4.3 7l3.2 3.2M4.6 7h5.4" fill="none" stroke="#000" stroke-width="1.7"/></svg>
                </button>
                <p class="visor__cuenta">1/1</p>
                <button type="button" class="visor__flecha" data-ir="1" aria-label="Foto siguiente">
                    <svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="7" fill="#c9c9c9"/><path d="M6.5 3.8 9.7 7l-3.2 3.2M9.4 7H4" fill="none" stroke="#000" stroke-width="1.7"/></svg>
                </button>
            </div>
            <button type="button" class="visor__cerrar">Close<span class="visor__circulo"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7" fill="none" stroke="#fff" stroke-width="1.4"/></svg></span></button>
        </div>
    </div>
</dialog>
{% endmacro %}

{# Ventana donde se reproduce el video (una por página) #}
{% macro ventanaVideo() %}
<dialog class="video-ventana" id="video-ventana" aria-label="Video">
    <button type="button" class="video-ventana__cerrar" aria-label="Cerrar el video">{{ icono('cerrar') }}</button>
    <video controls playsinline preload="none"></video>
</dialog>
{% endmacro %}