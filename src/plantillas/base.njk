<!DOCTYPE html>
<html lang="es-CO">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ titulo }}</title>
    <meta name="description" content="{{ descripcion }}">
    {% if ruta == '/404' %}
    <meta name="robots" content="noindex">
    {% else %}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <link rel="canonical" href="{{ sitio.url }}{{ ruta }}">
    {% endif %}

    <link rel="preload" href="{{ activos.fuentes.manrope }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ activos.fuentes.bodoni }}" as="font" type="font/woff2" crossorigin>
    {% block precarga %}{% endblock %}
    <link rel="stylesheet" href="{{ activos.css }}">
    <script src="{{ activos.js }}" defer></script>

    <link rel="icon" href="/favicon-32.png" sizes="32x32">
    <link rel="icon" href="/icono-192.png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="msapplication-TileImage" content="/icono-270.png">

    <meta property="og:locale" content="es_CO">
    <meta property="og:type" content="{{ 'website' if ruta == '/' else 'article' }}">
    <meta property="og:title" content="{{ titulo }}">
    <meta property="og:description" content="{{ descripcion }}">
    <meta property="og:url" content="{{ sitio.url }}{{ ruta }}">
    <meta property="og:site_name" content="CENPAIF">
    {% if imagen %}
    <meta property="og:image" content="{{ sitio.url }}{{ rutaFoto(imagen) }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">

    <script type="application/ld+json">{{ grafo | jsonld }}</script>
    {# Safari con Modo de Aislamiento (Lockdown) dice aceptar WebP y AVIF pero no los muestra.
       Si este navegador no puede abrir un WebP de 1 px, se quitan los formatos modernos y
       cada foto usa su copia JPEG/PNG. #}
    <script>(function(){var i=new Image();i.onerror=function(){var q=function(){document.querySelectorAll('picture source').forEach(function(s){s.remove()})};document.readyState==='loading'?document.addEventListener('DOMContentLoaded',q):q()};i.src='data:image/webp;base64,UklGRiIAAABXRUJQVlA4IBYAAAAwAQCdASoBAAEADsD+JaQAA3AAAAAA'})();</script>
</head>
<body{% if clase %} class="{{ clase }}"{% endif %}>
    {% include "encabezado.njk" %}

    <main>
        {% block contenido %}{% endblock %}
    </main>

    {% include "pie.njk" %}

    {# Botón flotante propio de WhatsApp (reemplaza al de masleads, que cargaba 243 KB) #}
    <a class="whatsapp-flotante" href="{{ whatsapp('Hola, vengo de la página web de CENPAIF y quiero una asesoría.') }}" target="_blank" rel="noopener" aria-label="Asesoría en línea por WhatsApp">
        {{ icono('whatsapp') }}<span>Asesoría en línea</span>
    </a>
</body>
</html>