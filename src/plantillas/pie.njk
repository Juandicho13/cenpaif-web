{# ---------- Contacto y ubicación (igual en todas las páginas) ---------- #}
<section class="contacto" id="contacto" aria-labelledby="contacto-titulo">
    <div class="contacto__caja">
        <div class="contacto__info">
            <h2 class="contacto__titulo" id="contacto-titulo">Centro Psicológico CENPAIF</h2>
            <p class="contacto__nombre">Dra. Claudia Díaz</p>

            <ul class="contacto__datos">
                <li>
                    <span class="contacto__icono">{{ icono('casa') }}</span>
                    <div>
                        <p class="contacto__etiqueta">Dirección</p>
                        <p>{{ sitio.direccion }}. {{ sitio.ciudad }}</p>
                        <a class="contacto__enlace" href="{{ sitio.enlaces.comoLlegar }}" target="_blank" rel="noopener">Cómo llegar</a>
                    </div>
                </li>
                <li>
                    <span class="contacto__icono">{{ icono('telefono') }}</span>
                    <div>
                        <p class="contacto__etiqueta">Teléfono y WhatsApp</p>
                        <a href="{{ sitio.telefonoEnlace }}">{{ sitio.telefono }}</a>
                    </div>
                </li>
                <li>
                    <span class="contacto__icono">{{ icono('correo') }}</span>
                    <div>
                        <p class="contacto__etiqueta">Correo</p>
                        <a href="mailto:{{ sitio.correo }}">{{ sitio.correo }}</a>
                    </div>
                </li>
            </ul>

            <ul class="redes redes--claras">
                {% for r in sitio.redes %}
                <li><a href="{{ r.url }}" target="_blank" rel="noopener" aria-label="{{ r.nombre }}">{{ icono(r.icono) }}</a></li>
                {% endfor %}
            </ul>
        </div>

        <form class="formulario" data-formulario-whatsapp>
            <h3 class="formulario__titulo">Escríbenos</h3>
            <p class="formulario__nota">El mensaje se abre en WhatsApp, listo para enviar.</p>
            <div class="formulario__grupo">
                <label for="contacto-nombre">Nombre</label>
                <input type="text" name="nombre" id="contacto-nombre" autocomplete="name">
            </div>
            <div class="formulario__grupo">
                <label for="contacto-email">Correo</label>
                <input type="email" name="email" id="contacto-email" autocomplete="email" required>
            </div>
            <div class="formulario__grupo">
                <label for="contacto-mensaje">Mensaje</label>
                <textarea name="mensaje" id="contacto-mensaje" rows="4"></textarea>
            </div>
            <label class="formulario__acepto">
                <input type="checkbox" name="acepto" required>
                <span>Autorizo el tratamiento de mis datos según la <a href="/politica-de-privacidad/">política de privacidad</a>.</span>
            </label>
            <button type="submit" class="formulario__enviar">{{ icono('whatsapp') }}Enviar por WhatsApp</button>
        </form>

    </div>
</section>

{# ---------- Pie ---------- #}
<footer class="pie">
    <div class="pie__caja">
        <p class="pie__nombre">CENPAIF</p>
        <nav aria-label="Enlaces del pie">
            <ul class="pie__enlaces">
                <li><a href="/alquiler-de-oficina-por-horas/">Alquiler de oficinas</a></li>
                <li><a href="/pagos/">Pagos</a></li>
                <li><a href="/politica-de-privacidad/">Política de privacidad</a></li>
                <li><a href="/terminos-y-condiciones/">Términos y condiciones</a></li>
            </ul>
        </nav>
    </div>

    <div class="derechos">
        <p>Todos los derechos reservados © Cenpaif {{ anio }}</p>
        <p class="firma">
            <span><span class="solo-lectores">Desarrollado por </span>juan-olarte-dev</span>
            <span class="firma-linea" aria-hidden="true"></span>
            <svg viewBox="0 0 30 20" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
                <path d="M11.3 2.3V13.6C11.3 16.5 9.3 18.2 6.9 18.2 5.1 18.2 3.6 17.4 2.7 16.1" stroke-width="2.3" />
                <circle cx="21" cy="10.8" r="7" stroke-width="2.3" />
                <circle cx="21" cy="10.8" r="2.1" stroke-width="0.9" />
            </svg>
        </p>
    </div>
</footer>
