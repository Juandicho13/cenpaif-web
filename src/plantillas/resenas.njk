{# Reseñas de Google con el widget de Trustindex, el mismo de la web original.
   Las reseñas están en src/resenas.mjs y el estilo en public/resenas/trustindex-google-widget.css.
   sitio.js carga el programa de Trustindex cuando las reseñas están por aparecer en pantalla. #}
<pre class="ti-widget" style="display: none"><template id="trustindex-google-widget-html"><div class=" ti-widget ti-goog ti-review-text-mode-readmore ti-text-align-left" data-no-translation="true" data-time-locale="%d %s ago|today|day|days|week|weeks|month|months|year|years" data-plugin-version="13.3.1" data-layout-id="4" data-layout-category="slider" data-set-id="light-background" data-pid="" data-language="en" data-close-locale="Close" data-review-target-width="300" data-css-version="2" data-reply-by-locale="Owner&apos;s reply" data-only-rating-locale="This user only left a rating." data-pager-autoplay-timeout="6">
<div class="ti-widget-container ti-col-3">
<div class="ti-reviews-container">
<div class="ti-controls">
<div class="ti-next" aria-label="Next review" role="button" tabindex="0"></div>
<div class="ti-prev" aria-label="Previous review" role="button" tabindex="0"></div>
</div>
<div class="ti-reviews-container-wrapper">
{% for r in resenas %}
<div data-empty="0" data-time="{{ r.tiempo }}" class="ti-review-item source-Google ti-image-layout-thumbnail" data-id="cfcd208495d565ef66e7dff9f98764da" data-language="">
<div class="ti-inner">
<div class="ti-review-header">
<div class="ti-platform-icon ti-with-tooltip">
<span class="ti-tooltip">Posted on Google</span>
<trustindex-image data-imgurl="https://cdn.trustindex.io/assets/platform/Google/icon.svg" alt="Google" width="20" height="20" loading="lazy"></trustindex-image>
</div>
<div class="ti-profile-img">
<trustindex-image data-imgurl="{{ r.foto }}" alt="{{ r.nombre }} profile picture" loading="lazy"></trustindex-image>
</div>
<div class="ti-profile-details">
<div class="ti-name"> {{ r.nombre }} </div>
<div class="ti-date"></div>
</div>
</div>
<span class="ti-stars">{% for n in [1, 2, 3, 4, 5] %}<trustindex-image class="ti-star" data-imgurl="https://cdn.trustindex.io/assets/platform/Google/star/f.svg" alt="Google star {{ n }}" width="17" height="17" loading="lazy"></trustindex-image>{% endfor %}<span class="ti-verified-review ti-verified-platform"><span class="ti-verified-tooltip">Trustindex verifies that the original source of the review is Google.</span></span></span>
<div class="ti-review-text-container ti-review-content"><!-- R-CONTENT -->{{ r.texto }}<!-- R-CONTENT --></div>
<span class="ti-read-more" data-container=".ti-review-content" data-collapse-text="Hide" data-open-text="Read more"></span>
</div>
</div>
{% endfor %}
</div>
<div class="ti-controls-line">
<div class="dot"></div>
</div>
</div>
</div>
</div></template></pre><div data-src="https://cdn.trustindex.io/loader.js?wp-widget" data-template-id="trustindex-google-widget-html" data-css-url="/resenas/trustindex-google-widget.css"></div>