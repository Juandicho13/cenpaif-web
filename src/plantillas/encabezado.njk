{# Encabezado "isla dinámica": una cápsula flotante arriba que se encoge al bajar (sitio.js) #}
<header class="isla" data-isla>
    <a class="isla__logo" href="/" aria-label="CENPAIF, ir al inicio">
        {{ foto('logo-transparente', 'CENPAIF, Claudia Yolima Díaz', { tamanos: '120px', prioridad: true }) }}
    </a>

    <nav class="menu" aria-label="Menú principal">
        <button class="menu__abrir" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label="Abrir el menú">
            <span></span><span></span><span></span>
        </button>
        <div class="menu__panel" id="menu-panel">
            <button class="menu__cerrar" type="button" aria-label="Cerrar el menú">{{ icono('cerrar') }}</button>
            <ul class="menu__lista">
                {% for item in sitio.menu %}
                {% if item.hijos %}
                <li class="menu__grupo{% if ruta in item.rutas %} actual{% endif %}">
                    <a href="#" class="menu__padre" aria-haspopup="true" aria-expanded="false">
                        {{ item.texto }}{{ icono('flecha-abajo', 'menu__flecha') }}
                    </a>
                    <ul class="submenu">
                        {% for h in item.hijos %}
                        <li><a href="{{ h.url }}"{% if h.url == ruta %} aria-current="page"{% endif %}>{{ h.texto }}</a></li>
                        {% endfor %}
                    </ul>
                </li>
                {% else %}
                <li><a href="{{ item.url }}"{% if item.url == ruta %} aria-current="page"{% endif %}>{{ item.texto }}</a></li>
                {% endif %}
                {% endfor %}
            </ul>
            <div class="menu__extra">
                <a class="isla__accion" href="{{ whatsapp('Hola, vengo de la página web de CENPAIF.') }}" target="_blank" rel="noopener">Escríbenos</a>
                <ul class="redes">
                    {% for r in sitio.redes %}
                    <li><a href="{{ r.url }}" target="_blank" rel="noopener" aria-label="{{ r.nombre }}">{{ icono(r.icono) }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </nav>

    <a class="isla__accion isla__accion--fija" href="{{ whatsapp('Hola, vengo de la página web de CENPAIF.') }}" target="_blank" rel="noopener">Escríbenos</a>
</header>
